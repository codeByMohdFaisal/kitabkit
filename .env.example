# Site
# Local dev: http://localhost:3000
# Production (set this in Vercel project env vars): https://kitabkit.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=mohdfaisal2140@gmail.com
# WhatsApp number in international format, no "+" or spaces
NEXT_PUBLIC_WHATSAPP_NUMBER=917055912140

# Master switch for the buy/checkout flow. Leave unset/false to launch with
# "Buy now" replaced by a "Notify me on WhatsApp" CTA and /checkout disabled.
# Set to "true" once Razorpay is live and lib/payments/razorpay.ts is wired
# to real API calls.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# Razorpay — see lib/payments/razorpay.ts for how these are used.
# Leave unset to run checkout in simulated/stub mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Resend — see lib/delivery/index.ts. Leave RESEND_API_KEY unset to skip
# emailing (the buyer still gets the download link on-screen).
# Domain (e.g. kitabkit.com) must be verified in the Resend dashboard first.
RESEND_API_KEY=
# Defaults to "Kitaab Kit <orders@kitabkit.com>" if unset.
RESEND_FROM_EMAIL=
